# AWS Configuration
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=your_account_id
ALERT_EMAIL=your_email@example.com

# Terraform Variables (read directly by Terraform CLI)
TF_VAR_account_id=your_account_id
TF_VAR_alert_emails=["your_email@example.com"]

# Backend API
API_ID=your_api_id
BACKEND_URL=https://<api-id>.execute-api.us-west-2.amazonaws.com/develop
